/dts-v1/;

#include "x2600.dtsi"

/ {
	compatible = "flashforge,ad5x", "ingenic,x2600";
	model = "Flashforge Adventurer 5X";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>,
		      <0x30000000 0x10000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* Kept by the stock firmware for its media drivers ("rmem") */
		media@ec00000 {
			reg = <0x0ec00000 0x01000000>;
			no-map;
		};

		/* Firmware of the SoC's RISC-V core ("rtos_size") */
		rtos@fc00000 {
			reg = <0x0fc00000 0x00400000>;
			no-map;
		};
	};
};

&exclk {
	clock-frequency = <24000000>;
};

&pinctrl {
	pins_uart0: uart0 {
		function = "uart0";
		groups = "uart0-e";
	};
};

/* Debug console */
&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart0>;

	status = "okay";
};
