// SPDX-License-Identifier: GPL-2.0
/dts-v1/;

#include "x2600.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "flashforge,ad5x", "ingenic,x2600";
	model = "Flashforge Adventurer 5X";

	aliases {
		mmc0 = &msc0;
		serial0 = &uart0;
		serial2 = &uart2;
		serial4 = &uart4;
		serial5 = &uart5;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>,
		      <0x30000000 0x10000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* Kept by the stock firmware for its media drivers ("rmem") */
		media@ec00000 {
			reg = <0x0ec00000 0x01000000>;
			no-map;
		};

		/* Firmware of the SoC's RISC-V core ("rtos_size") */
		rtos@fc00000 {
			reg = <0x0fc00000 0x00400000>;
			no-map;
		};
	};

	vcc_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	/* The RTL8821CU Wi-Fi module, behind the USB hub */
	regulator-wifi {
		compatible = "regulator-fixed";
		regulator-name = "wifi-power";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpb 7 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		vin-supply = <&vcc_3v3>;
	};
};

&exclk {
	clock-frequency = <24000000>;
};

&mac {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_mac>;

	phy-mode = "rmii";
	phy-handle = <&ip101g>;

	status = "okay";
};

&mdio {
	status = "okay";

	ip101g: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
	};
};

/* eMMC */
&msc0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_mmc0>;

	bus-width = <8>;
	max-frequency = <150000000>;
	non-removable;
	no-sd;
	no-sdio;

	status = "okay";
};

/* OTG port: not on the display's USB ports; set up as the stock firmware does */
&otg {
	dr_mode = "otg";

	status = "okay";
};

&otg_phy {
	vcc-supply = <&vcc_3v3>;
	ingenic,external-vbus-detect;

	status = "okay";
};

&pinctrl {
	pins_mac: mac {
		function = "mac0";
		groups = "mac0-rmii";
	};

	pins_mmc0: mmc0 {
		function = "mmc0";
		groups = "mmc0-4bit", "mmc0-8bit";
	};

	pins_uart0: uart0 {
		function = "uart0";
		groups = "uart0-e";
	};

	pins_uart2: uart2 {
		function = "uart2";
		groups = "uart2-data";
	};

	pins_uart4: uart4 {
		function = "uart4";
		groups = "uart4-data-b";
	};

	pins_uart5: uart5 {
		function = "uart5";
		groups = "uart5-data-b";
	};
};

/* Debug console */
&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart0>;

	status = "okay";
};

/* Motion controller (Klipper MCU) */
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart2>;

	status = "okay";
};

/*
 * Filament changer (IFS): half-duplex RS-485, driver enable on PC3. The
 * transceiver does not echo what it sends, and the IFS answers within a
 * frame: keep receiving while sending, so that its reply is not flushed
 * with the receive FIFO when the driver enable drops.
 */
&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart4>;

	rts-gpios = <&gpc 3 GPIO_ACTIVE_HIGH>;
	linux,rs485-enabled-at-boot-time;
	rs485-rx-during-tx;

	status = "okay";
};

/* Toolhead board (eboard, Klipper MCU) */
&uart5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart5>;

	status = "okay";
};

/* Host port: an internal USB hub with the camera and the Wi-Fi module */
&usb {
	dr_mode = "host";
	disable-over-current;

	status = "okay";
};

&usb_phy {
	vcc-supply = <&vcc_3v3>;

	status = "okay";
};
