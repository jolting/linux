/dts-v1/;

#include "x2600.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	compatible = "flashforge,ad5x", "ingenic,x2600";
	model = "Flashforge Adventurer 5X";

	aliases {
		mmc0 = &msc0;
		serial0 = &uart0;
		serial2 = &uart2;
		serial4 = &uart4;
		serial5 = &uart5;
		serial7 = &uart7;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>,
		      <0x30000000 0x10000000>;
	};

	backlight: backlight {
		compatible = "gpio-backlight";
		gpios = <&gpc 14 GPIO_ACTIVE_HIGH>;
	};

	panel {
		compatible = "flashforge,ad5x-panel", "panel-lvds";
		backlight = <&backlight>;

		data-mapping = "vesa-24";
		width-mm = <108>;
		height-mm = <64>;

		panel-timing {
			clock-frequency = <31000000>;
			hactive = <800>;
			vactive = <480>;
			hfront-porch = <40>;
			hback-porch = <88>;
			hsync-len = <48>;
			vfront-porch = <13>;
			vback-porch = <35>;
			vsync-len = <3>;
		};

		port {
			panel_in: endpoint {
				remote-endpoint = <&dpu_out>;
			};
		};
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* Kept by the stock firmware for its media drivers ("rmem") */
		media@ec00000 {
			reg = <0x0ec00000 0x01000000>;
			no-map;
		};

		/* Firmware of the SoC's RISC-V core ("rtos_size") */
		rtos@fc00000 {
			reg = <0x0fc00000 0x00400000>;
			no-map;
		};
	};

	vcc_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	/* The RTL8821CU Wi-Fi module, behind the USB hub */
	regulator-wifi {
		compatible = "regulator-fixed";
		regulator-name = "wifi-power";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpb 7 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		vin-supply = <&vcc_3v3>;
	};
};

&dpu {
	/*
	 * The panel's 31 MHz pixel clock from the EPLL at 434 MHz, as the
	 * stock firmware sets it: nothing else may have set it up yet
	 */
	assigned-clocks = <&cgu X2600_CLK_EPLL>, <&cgu X2600_CLK_LCD>;
	assigned-clock-parents = <0>, <&cgu X2600_CLK_EPLL>;
	assigned-clock-rates = <434000000>, <31000000>;

	phys = <&dsi_dphy>;
	phy-names = "lvds";

	status = "okay";

	port {
		dpu_out: endpoint {
			remote-endpoint = <&panel_in>;
		};
	};
};

&dsi_dphy {
	status = "okay";
};

&exclk {
	clock-frequency = <24000000>;
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_i2c0>;

	clock-frequency = <400000>;

	status = "okay";

	/* The display's resistive touchscreen */
	touchscreen@48 {
		compatible = "ti,tsc2007";
		reg = <0x48>;

		interrupt-parent = <&gpc>;
		interrupts = <7 IRQ_TYPE_EDGE_FALLING>;
		gpios = <&gpc 7 GPIO_ACTIVE_LOW>;

		ti,x-plate-ohms = <660>;
		ti,max-rt = <600>;
	};
};

&mac {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_mac>;

	phy-mode = "rmii";
	phy-handle = <&ip101g>;

	status = "okay";
};

&mdio {
	status = "okay";

	ip101g: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
	};
};

/* eMMC */
&msc0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_mmc0>;

	bus-width = <8>;
	max-frequency = <150000000>;
	non-removable;
	no-sd;
	no-sdio;

	status = "okay";
};

/* OTG port: not on the display's USB ports; set up as the stock firmware does */
&otg {
	dr_mode = "otg";

	status = "okay";
};

&otg_phy {
	vcc-supply = <&vcc_3v3>;
	ingenic,external-vbus-detect;

	status = "okay";
};

&pinctrl {
	pins_i2c0: i2c0 {
		function = "i2c0";
		groups = "i2c0-data-c";
	};

	pins_mac: mac {
		function = "mac0";
		groups = "mac0-rmii";
	};

	pins_mmc0: mmc0 {
		function = "mmc0";
		groups = "mmc0-4bit", "mmc0-8bit";
	};

	pins_pwm13: pwm13 {
		function = "pwm13";
		groups = "pwm13";
	};

	pins_uart0: uart0 {
		function = "uart0";
		groups = "uart0-e";
	};

	pins_uart2: uart2 {
		function = "uart2";
		groups = "uart2-data";
	};

	pins_uart4: uart4 {
		function = "uart4";
		groups = "uart4-data-b";
	};

	pins_uart5: uart5 {
		function = "uart5";
		groups = "uart5-data-b";
	};

	pins_uart7: uart7 {
		function = "uart7";
		groups = "uart7-data-c";
	};
};

/* Debug console */
/* Speaker: a piezo on PC12 */
&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_pwm13>;

	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart0>;

	status = "okay";
};

/* Motion controller (Klipper MCU) */
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart2>;

	status = "okay";
};

/*
 * Filament changer (IFS): half-duplex RS-485, driver enable on PC3. The
 * transceiver does not echo what it sends, and the IFS answers within a
 * frame: keep receiving while sending, so that its reply is not flushed
 * with the receive FIFO when the driver enable drops.
 */
&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart4>;

	rts-gpios = <&gpc 3 GPIO_ACTIVE_HIGH>;
	linux,rs485-enabled-at-boot-time;
	rs485-rx-during-tx;

	status = "okay";
};

/* Toolhead board (eboard, Klipper MCU) */
&uart5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart5>;

	status = "okay";
};

/* Bed weighing board */
&uart7 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart7>;

	status = "okay";
};

/* Host port: an internal USB hub with the camera and the Wi-Fi module */
&usb {
	dr_mode = "host";
	disable-over-current;

	status = "okay";
};

&usb_phy {
	vcc-supply = <&vcc_3v3>;

	status = "okay";
};
